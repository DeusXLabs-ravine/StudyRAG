{
  "expo": {
    "name": "StudyRAG",
    "slug": "studyrag-mobile",
    "version": "1.0.0",
    "scheme": "studyrag",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "plugins": [
      "expo-router",
      [
        "@sentry/react-native/expo",
        {
          "organization": "duesx-e1",
          "project": "studyrag",
          "url": "https://sentry.io/"
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      "expo-audio",
      "expo-asset",
      "@bacons/apple-targets",
      "./plugins/withStudyRAGNativeExtensions",
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.studyrag.app",
      "appleTeamId": "KJWN27VC5D",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.studyrag.app"
        ]
      },
      "infoPlist": {
        "NSMicrophoneUsageDescription": "StudyRAG uses the microphone for the voice-based Teach mode so you can have live study conversations with your AI tutor.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.studyrag.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0EA5E9"
      },
      "permissions": [
        "com.android.vending.BILLING",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "cd60ce80-7ba9-434d-a58b-12ddcf5c0072"
      }
    },
    "owner": "lyon98.dbios",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/cd60ce80-7ba9-434d-a58b-12ddcf5c0072"
    }
  }
}
