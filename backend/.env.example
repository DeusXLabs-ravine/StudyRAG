PORT=5000
NODE_ENV=development

# App
APP_BASE_URL=https://studyrag.co

# Supabase (required)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Google Gemini API (primary + optional rotation keys)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=

# DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key

# File Upload
MAX_FILE_SIZE=209715200
ALLOWED_FILE_TYPES=pdf,docx,txt,md

# CORS
ALLOWED_ORIGINS=http://localhost:5173

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (Resend)
RESEND_API_KEY=your_resend_api_key

# Webhook shared secret (Cloudflare Worker → backend email webhook)
WEBHOOK_SECRET=your_webhook_shared_secret

# Admin: comma-separated emails that permanently receive max tier (no payment)
# Example: ADMIN_MAX_EMAILS=founder@studyrag.co,demo@studyrag.co
ADMIN_MAX_EMAILS=

# Monnify (Nigerian payment gateway)
# Dashboard: https://app.monnify.com → Settings → API Keys
MONNIFY_API_KEY=your_monnify_api_key
MONNIFY_SECRET_KEY=your_monnify_secret_key
MONNIFY_CONTRACT_CODE=your_monnify_contract_code

# Paystack (Nigerian payment gateway)
# Dashboard: https://dashboard.paystack.com → Settings → API Keys & Webhooks
# Webhook URL to set: https://api.studyrag.co/webhooks/paystack
PAYSTACK_SECRET_KEY=your_paystack_secret_key
